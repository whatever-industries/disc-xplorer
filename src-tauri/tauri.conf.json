{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disc Xplorer",
  "version": "2.0.18",
  "identifier": "com.jaguar.optical-disc-explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disc Xplorer",
        "width": 920,
        "height": 540,
        "visible": false,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RkQzMEM0QjEwRkUxQjgKUldTNDRRK3h4REQ5VlZuWk9scENVdW5HZHlIbk55cC9WUktOYnRXVVRNakdhZG9FQ0ttb0tVbmcK",
      "endpoints": [
        "https://github.com/whatever-industries/disc-xplorer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "app",
      "appimage"
    ],
    "externalBin": [
      "binaries/redumper"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "iso",
          "bin",
          "img",
          "cue",
          "chd",
          "mds",
          "mdx",
          "nrg",
          "ccd",
          "cdi",
          "gdi",
          "b5t",
          "b6t",
          "bwt",
          "c2d",
          "pdi",
          "daa",
          "cso",
          "ciso",
          "zso",
          "ecm",
          "uif",
          "cif",
          "wbfs",
          "wux",
          "wud",
          "fatx",
          "scram",
          "sdram",
          "sbram"
        ],
        "name": "Disc Image",
        "description": "Disc image",
        "role": "Viewer",
        "mimeType": "application/x-cd-image"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "template": "installer/template.nsi"
      }
    }
  }
}
