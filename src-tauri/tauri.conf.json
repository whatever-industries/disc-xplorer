{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disc Xplorer",
  "version": "1.5.1",
  "identifier": "com.jaguar.optical-disc-explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disc Xplorer",
        "width": 1100,
        "height": 650,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "appimage"
    ],
    "externalBin": [
      "binaries/redumper"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "iso",
          "bin",
          "img",
          "cue",
          "chd",
          "mds",
          "mdx",
          "nrg",
          "ccd",
          "cdi",
          "gdi",
          "b5t",
          "b6t",
          "bwt",
          "c2d",
          "pdi",
          "daa",
          "cso",
          "ciso",
          "ecm",
          "uif",
          "cif",
          "wbfs",
          "wux",
          "wud",
          "fatx",
          "scram",
          "sdram",
          "sbram"
        ],
        "name": "Disc Image",
        "description": "Disc image",
        "role": "Viewer",
        "mimeType": "application/x-cd-image"
      }
    ]
  }
}
