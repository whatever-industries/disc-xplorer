{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "sv*"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-theme",
    "opener:default",
    "updater:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
